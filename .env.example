# Copia este archivo a .env solo para desarrollo local.
# El archivo .env real está excluido de Git y nunca debe publicarse.

# Ruta alternativa de la base SQLite (por defecto %LOCALAPPDATA%\HiQNet\POS\data\hiqnet-pos.db)
HIQNET_POS_DB_PATH=C:\ruta\de\desarrollo\hiqnet-pos.db

# Nivel de logs de la aplicación (info, debug, warn, error)
RUST_LOG=info

# Ejemplo de configuración de plataforma (no aplica al POS)
# DATABASE_URL=postgres://hiqnet:hiqnet_dev@localhost:5432/hiqnet
