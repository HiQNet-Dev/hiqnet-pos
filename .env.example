# Copia este archivo a .env solo para desarrollo local.
# El archivo .env real está excluido de Git y nunca debe publicarse.

# Ruta alternativa de la base SQLite. Sin esta variable la aplicación usa:
#   Windows: %LOCALAPPDATA%\HiQNet\POS\data\hiqnet-pos.db
#   Linux:   $XDG_DATA_HOME/hiqnet-pos/data/hiqnet-pos.db
#            (o ~/.local/share/hiqnet-pos/data/hiqnet-pos.db)
# Útil para aislar pruebas; nunca apuntes a una base con datos reales.
HIQNET_POS_DB_PATH=

# Nivel de logs de la aplicación (info, debug, warn, error)
RUST_LOG=info
